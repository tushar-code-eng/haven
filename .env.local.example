# Copy this file to .env.local and fill it in. NEVER commit .env.local or share these values.
# Restart the dev server after changing it.

# --- Razorpay (Dashboard > Account & Settings > API Keys). Use Test Mode keys (rzp_test_...) first. ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
# The USD price needs "International Payments" enabled on your Razorpay account.

# --- Webhook (Dashboard > Account & Settings > Webhooks). ---
# URL: https://YOUR-DOMAIN/api/razorpay-webhook   Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=the_secret_you_set_on_the_webhook

# --- Delivery ---
# What buyers receive: a link to your setup guide + companion prompt (Notion page, Google Doc, etc.).
DELIVERY_URL=https://your-setup-guide-link

# Email delivery via Resend (https://resend.com). EMAIL_FROM must use a domain you have verified there.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Haven <hello@haven-love.com>
